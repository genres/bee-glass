{
  "manifest_version": 2,
  "name": "bee glass",
  "version": "1.0.0",
  "description": "Warm dark Firefox theme from the bee glass desktop: one flush surface from tabs to toolbar, a soft gold accent and high-contrast menus.",
  "author": "bee",
  "browser_specific_settings": { "gecko": { "id": "bee-glass-theme@bee.local" } },
  "theme": {
    "colors": {
      "frame": "#120e09",
      "frame_inactive": "#1b150d",
      "toolbar": "#120e09",
      "toolbar_text": "#e8e2d8",
      "toolbar_top_separator": "rgba(0, 0, 0, 0)",
      "toolbar_bottom_separator": "rgba(0, 0, 0, 0)",
      "toolbar_vertical_separator": "rgba(232, 226, 216, 0.12)",
      "tab_selected": "#251f16",
      "tab_text": "#f4efe7",
      "tab_background_text": "#cfc6b8",
      "tab_line": "#b89e78",
      "tab_loading": "#b89e78",
      "toolbar_field": "#251f16",
      "toolbar_field_text": "#e8e2d8",
      "toolbar_field_border": "rgba(232, 226, 216, 0.14)",
      "toolbar_field_focus": "#2c251b",
      "toolbar_field_text_focus": "#ffffff",
      "toolbar_field_border_focus": "#b89e78",
      "toolbar_field_highlight": "#a8c8f0",
      "toolbar_field_highlight_text": "#101216",
      "popup": "#100e0b",
      "popup_text": "#f4efe7",
      "popup_border": "rgba(244, 239, 231, 0.28)",
      "popup_highlight": "#3a3024",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#120e09",
      "sidebar_text": "#f4efe7",
      "sidebar_border": "rgba(232, 226, 216, 0.12)",
      "sidebar_highlight": "#3a3024",
      "sidebar_highlight_text": "#ffffff",
      "icons": "#e8e2d8",
      "icons_attention": "#b89e78",
      "button_background_hover": "rgba(232, 226, 216, 0.10)",
      "button_background_active": "rgba(232, 226, 216, 0.18)",
      "ntp_background": "#120e09",
      "ntp_text": "#e8e2d8"
    },
    "properties": { "color_scheme": "dark", "content_color_scheme": "system" }
  }
}
